<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form" model="ir.ui.view">
            <field name="model">account.invoice</field>
            <field name="name">account.invoice.afip.form</field>
            <field name="inherit_id" ref="l10n_ar_afipws_fe.view_invoice_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_invoice_open']" position="after">
                    <button name="get_pyafipws_currency_rate" type="object" 
                        attrs="{'invisible': ['|', '|', ('state', '!=', 'draft'), ('validation_type', '=', False), ('date_invoice', '=', False)]}" 
                        string="Check rate" groups="account.group_account_invoice"/>
                </xpath>
                <xpath expr="//field[@name='afip_asoc_period_start']" position="after">
                    <field name='l10n_ar_payment_foreign_currency'/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
